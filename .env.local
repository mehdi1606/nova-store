# ─────────────────────────────────────────────────────────────────────────────
# Nova Cavalia — Supabase environment
#
# Fill these in with the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# This file is git-ignored — your keys stay on your machine and are NEVER
# committed. On Vercel, add the SAME three variables under
#   Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Project URL — e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://esszybzysbvsylbsmpmd.supabase.co

# anon / public key — safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qOXHjqQemYtO6btbK8GOxA_ytawWPBo

# service_role / secret key — SERVER ONLY. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# The single owner email allowed into /admin (already set to your login).
NEXT_PUBLIC_ADMIN_EMAIL=hoaurimehdi7@gmail.com

# WhatsApp number that receives orders (paiement à la livraison).
# International format, digits only: 212 (Morocco) + your number without the 0.
# Example: 0612345678  ->  212669933727
NEXT_PUBLIC_WHATSAPP_NUMBER=212669933727

# Auto-send every order to YOUR WhatsApp (free, via CallMeBot).
# One-time setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
#   1. Add their WhatsApp number to your contacts.
#   2. Send them: "I allow callmebot to send me messages"
#   3. They reply with your personal apikey — paste it below.
CALLMEBOT_APIKEY=
